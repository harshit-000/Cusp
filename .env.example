# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` — it is git-ignored on purpose.

# --- Required (Phase 1+) ---
# Postgres connection string (Neon or Supabase free tier both work)
DATABASE_URL=

# Deployment only: your config as JSON (since jobscout.config.ts is git-ignored).
# Generate it with `npm run config:json` and paste the output here on Vercel.
# Leave blank locally — the local jobscout.config.ts file is used instead.
JOBSCOUT_CONFIG=

# Optional: protect the /api/ingest cron endpoint. If set, callers must send
# `Authorization: Bearer <this value>`. Vercel Cron sends it automatically.
CRON_SECRET=

# --- Optional: password-gate the dashboard (recommended once deployed) ---
# Set BOTH to turn on the login gate. Leave blank for no auth (fine locally).
# APP_PASSWORD = the password you type to sign in.
# AUTH_SECRET  = any long random string (e.g. `openssl rand -hex 32`).
APP_PASSWORD=
AUTH_SECRET=

# --- Optional: broad discovery (Phase 4) ---
# Free key from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Optional: morning digest (Phase 5) ---
# Create a bot via @BotFather, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
